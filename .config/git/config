[user]
	name = youyoumu
	email = 19760884+youyoumu@users.noreply.github.com

[init]
	defaultBranch = main

[color]
	ui = auto

[pull]
	rebase = false

[safe]
	directory = *

[core]
	editor = nvim
	autocrlf = input

[merge]
  conflictstyle = zdiff3

[alias]
  dl = -c diff.external=difft log -p --ext-diff
  ds = -c diff.external=difft show --ext-diff
  dft = -c diff.external=difft diff

[difftool "difftastic"]
  cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[difftool]
  prompt = false

[pager]
  difftool = true

[diff]
  tool = difftastic

[includeIf "gitdir:C:/Users/yym/"]
  path = ~/.config/git/gitconfig.windows

[includeIf "gitdir:/"]
  path = ~/.config/git/gitconfig.linux

